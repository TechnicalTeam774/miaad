{
  "appId": "app.miaad.tasks",
  "appName": "ميعاد",
  "webDir": "www",
  "android": {
    "backgroundColor": "#F3F5F9"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_miaad",
      "iconColor": "#2F6BFF"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "BackgroundRunner": {
      "label": "app.miaad.tasks.sync",
      "src": "runners/sync.js",
      "event": "sync",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    }
  }
}
